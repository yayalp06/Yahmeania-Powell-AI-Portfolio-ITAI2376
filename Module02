    "        all_preds.extend(preds.cpu().numpy().tolist())\n",
    "        all_true.extend(yb.cpu().numpy().tolist())\n",
    "\n",
    "print(\"\\n📌 PyTorch Test Classification Report:\")\n",
    "print(classification_report(all_true, all_preds))"
